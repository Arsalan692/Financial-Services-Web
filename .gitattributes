# Normalise line endings so the repo stays clean across Windows and the
# Linux boxes it will build on (Vercel, CI). Without this, Git warns on
# every add and diffs show whole files as changed.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Minified vendor CSS is not worth reviewing line by line in diffs.
*.min.css linguist-vendored
frontend/public/assets/css/style.css linguist-vendored
