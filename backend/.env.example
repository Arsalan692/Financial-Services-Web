# Copy to .env and fill in. Without SMTP settings the endpoint still
# accepts and records enquiries — they land in enquiries.jsonl — it just
# cannot email them on.

ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.example

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=website@your-domain.example
MAIL_TO=enquiries@your-domain.example

# Where accepted enquiries are appended, one JSON object per line.
ENQUIRY_LOG=enquiries.jsonl
