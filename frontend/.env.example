# Copy to .env.local for a local build, or set these in the host's
# build environment. Neither is needed for ordinary development: with
# both unset the contact forms post to /api/contact and Vite proxies
# that to the FastAPI app in ../backend.
#
# Vite only exposes variables prefixed VITE_, and it inlines them into
# the built JavaScript. Nothing secret can go in this file.

# Hosted form service the deployed site posts to.
# Web3Forms:  https://api.web3forms.com/submit
VITE_FORM_ENDPOINT=

# The access key for that form. Public by design — it identifies the
# form, it does not authorise anything. Kept out of the repo so it can
# be rotated without a commit.
VITE_FORM_ACCESS_KEY=
